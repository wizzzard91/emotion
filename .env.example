# Copy to .env and fill in the values. Never commit .env.

# --- Server ---
PORT=3000
# Set to true when served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false
# Which proxy hops may set X-Forwarded-For: loopback (default), true, a hop count or a CIDR list.
# compose.yaml sets uniquelocal, which is right for a reverse proxy on the Docker host.
# TRUST_PROXY=loopback
# Maximum size of a single uploaded file, in MB
MAX_UPLOAD_MB=2048

# --- Database (MongoDB) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app>
MONGODB_DB=emotion

# --- First administrator ---
# Created on startup if no user with this login exists yet.
# Everyone else is added by an administrator in the web UI.
ADMIN_LOGIN=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# --- File storage (S3-compatible: Alarik, MinIO, ...) ---
S3_ENDPOINT=http://localhost:8080
S3_REGION=us-east-1
# The bucket must already exist
S3_BUCKET=emotion
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style URLs (http://host/bucket/key); required by most self-hosted servers
S3_FORCE_PATH_STYLE=true
