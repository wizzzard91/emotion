<%- include('partials/header') %>
<section class="card card-narrow">
  <h1>Вход</h1>
  <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login">
    <input type="hidden" name="next" value="<%= next %>">
    <label class="field">
      <span>Логин</span>
      <input type="text" name="login" value="<%= login %>" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
    </label>
    <label class="field">
      <span>Пароль</span>
      <input type="password" name="password" autocomplete="current-password" required>
    </label>
    <button class="btn btn-primary auth-submit" type="submit">Войти</button>
  </form>
  <p class="muted auth-hint">Забыли пароль — попросите администратора задать новый.</p>
</section>
<%- include('partials/footer') %>
