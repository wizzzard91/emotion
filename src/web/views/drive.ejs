<%- include('partials/header') %>
<%
  const here = folder ? `${base}/folder/${folder.id}` : base;
  const icon = (name) => `<svg class="icon icon-${name}" aria-hidden="true"><use href="#i-${name}"></use></svg>`;
%>
<svg class="sprite" aria-hidden="true" focusable="false">
  <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.6l2 2.5h8.4A1.5 1.5 0 0 1 21 9v8.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z" fill="currentColor"/></symbol>
  <symbol id="i-file" viewBox="0 0 24 24"><path d="M6.5 3h7L19 8.5v11a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 19.5v-15A1.5 1.5 0 0 1 6.5 3zM13 4v5h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></symbol>
  <symbol id="i-lock" viewBox="0 0 24 24"><path d="M7.5 10.5V8a4.5 4.5 0 0 1 9 0v2.5M6.5 10.5h11a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-7.5a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</svg>

<nav class="crumbs" aria-label="Путь">
  <% if (folder) { %><a href="<%= base %>">Диск</a><% } else { %><span class="crumb-current">Диск</span><% } %>
  <% path.forEach((p, i) => { %>
    <span class="crumb-sep" aria-hidden="true">›</span>
    <% if (i === path.length - 1) { %>
      <span class="crumb-current"><%= p.name %></span>
    <% } else { %>
      <a href="<%= base %>/folder/<%= p.id %>"><%= p.name %></a>
    <% } %>
  <% }) %>
  <% if (insidePrivate) { %>
    <span class="badge" title="Содержимое видите только вы"><%- icon('lock') %> приватная</span>
  <% } %>
</nav>

<% if (flashOk) { %><div class="flash flash-ok" role="status"><%= flashOk %></div><% } %>
<% if (flashErr) { %><div class="flash flash-error" role="alert"><%= flashErr %></div><% } %>

<div class="toolbar">
  <details class="tool" data-upload-tool>
    <summary class="btn btn-primary">Загрузить файлы</summary>
    <form class="tool-panel card" method="post" action="<%= here %>/upload" enctype="multipart/form-data" data-upload-form>
      <label class="field">
        <span>Можно выбрать несколько, до <%= maxUpload %> каждый</span>
        <input type="file" name="files" multiple required>
      </label>
      <button class="btn btn-primary" type="submit">Загрузить</button>
    </form>
  </details>

  <details class="tool">
    <summary class="btn">Новая папка</summary>
    <form class="tool-panel card" method="post" action="<%= here %>/folder">
      <label class="field">
        <span>Название</span>
        <input type="text" name="name" required maxlength="255" autocomplete="off">
      </label>
      <label class="check">
        <input type="checkbox" name="private" value="1">
        <span>Приватная — видна только мне</span>
      </label>
      <button class="btn btn-primary" type="submit">Создать</button>
    </form>
  </details>
</div>

<div class="upload-status" data-upload-status hidden>
  <span data-upload-text>Загрузка…</span>
  <progress max="100" value="0" data-upload-progress></progress>
</div>

<% if (entries.length === 0) { %>
  <section class="card empty">
    <p class="empty-title">Здесь пока пусто</p>
    <p class="muted">Загрузите файлы кнопкой выше<span class="js-only"> или просто перетащите их на страницу</span>.</p>
  </section>
<% } else { %>
  <section class="card drive-card">
    <table class="table drive-table">
      <thead>
        <tr>
          <th>Имя</th>
          <th class="hide-mobile">Владелец</th>
          <th class="num">Размер</th>
          <th class="hide-mobile">Изменён</th>
          <th class="col-actions"><span class="sr-only">Действия</span></th>
        </tr>
      </thead>
      <tbody>
      <% for (const e of entries) {
           const isFolder = e.kind === 'folder';
           const manage = canManage(e);
           const mine = e.ownerId === user.id;
           const preview = !isFolder && inlineType(e.name) !== null;
           const url = isFolder ? `${base}/folder/${e.id}` : `${base}/file/${e.id}`; %>
        <tr>
          <td class="col-name">
            <a class="entry" href="<%= url %>">
              <%- icon(isFolder ? 'folder' : 'file') %>
              <span class="entry-name"><%= e.name %></span>
            </a>
            <% if (e.isPrivate) { %>
              <span class="badge" title="Приватная папка: видна только вам"><%- icon('lock') %><span class="hide-mobile"> приватная</span></span>
            <% } %>
          </td>
          <td class="hide-mobile muted"><%= mine ? 'Вы' : e.ownerName %></td>
          <td class="num muted"><%= isFolder ? '—' : formatSize(e.size) %></td>
          <td class="hide-mobile muted col-date"><time datetime="<%= toIso(e.createdAt) %>"><%= formatDate(e.createdAt) %></time></td>
          <td class="col-actions">
            <% if (manage || !isFolder) { %>
            <details class="row-menu">
              <summary class="btn btn-small" aria-label="Действия: <%= e.name %>" title="Действия">⋯</summary>
              <div class="row-menu-panel card">
                <% if (!isFolder) { %>
                  <div class="menu-links">
                    <a class="btn btn-small" href="<%= url %>">Скачать</a>
                    <% if (preview) { %><a class="btn btn-small" href="<%= url %>?inline=1" target="_blank" rel="noopener">Открыть в браузере</a><% } %>
                  </div>
                <% } %>
                <% if (manage) { %>
                  <form class="menu-rename" method="post" action="<%= base %>/node/<%= e.id %>/rename">
                    <input type="text" name="name" value="<%= e.name %>" required maxlength="255" autocomplete="off" aria-label="Новое имя">
                    <button class="btn btn-small" type="submit">Переименовать</button>
                  </form>
                <% } %>
                <% if (isFolder && mine) { %>
                  <form method="post" action="<%= base %>/node/<%= e.id %>/privacy">
                    <input type="hidden" name="private" value="<%= e.isPrivate ? '0' : '1' %>">
                    <button class="btn btn-small menu-wide" type="submit"><%= e.isPrivate ? 'Открыть для всей команды' : 'Сделать приватной' %></button>
                  </form>
                <% } %>
                <% if (manage) { %>
                  <form method="post" action="<%= base %>/node/<%= e.id %>/delete"
                        data-confirm="<%= isFolder ? `Удалить папку «${e.name}» со всем содержимым?` : `Удалить файл «${e.name}»?` %>">
                    <button class="btn btn-small btn-danger menu-wide" type="submit"><%= isFolder ? 'Удалить папку со всем содержимым' : 'Удалить' %></button>
                  </form>
                <% } %>
              </div>
            </details>
            <% } %>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </section>
<% } %>

<div class="drop-hint" aria-hidden="true"><div>Отпустите файлы, чтобы загрузить их сюда</div></div>
<script src="/static/drive.js" defer></script>
<%- include('partials/footer') %>
